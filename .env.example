# SpideHarness Agent — 环境变量模板
# 复制为 .env 后填入真实值：
#   cp .env.example .env
#   source .env
# 强烈建议把 .env 加入 .gitignore（仓库已默认忽略）

# ── 飞书智能体 ────────────────────────────────────────────────────────
# App Secret（必填，从飞书开放平台 https://open.feishu.cn 获取）
export SPIDE_FEISHU__APP_SECRET="your_app_secret_here"

# Verification Token（选填，配置事件订阅 URL 验证时使用）
export SPIDE_FEISHU__VERIFICATION_TOKEN=""

# Encrypt Key（选填，启用加密通信时使用）
export SPIDE_FEISHU__ENCRYPT_KEY=""

# ── LLM (本地服务, 通常无需鉴权) ─────────────────────────────────────
# 如果本地 LLM 服务启用了鉴权,在此设置
export SPIDE_LLM__LOCAL_API_KEY="EMPTY"

# ── 联网搜索 / Web 抓取（可选）────────────────────────────────────────
# export SPIDE_WEBSEARCH__ZHIPU_API_KEY=""
# export SPIDE_UAPI__API_KEY=""

# ── 飞书 Webhook（可选,用于告警渠道）────────────────────────────────
# export SPIDE_ALERT__NOTIFICATION__FEISHU_URL="https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx"
